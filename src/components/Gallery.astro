---
import { Image, getImage } from "astro:assets";
import type { Category } from "../data";

interface Props {
  category: Category;
}

const { category } = Astro.props;
const full = await Promise.all(
  category.photos.map((p) => getImage({ src: p, width: 1600, format: "webp" })),
);
---

<section id={category.slug} class="section gallery">
  <div class="container">
    <h2>{category.title}</h2>
    <p class="lead">{category.blurb}</p>
    <ul>
      {category.photos.map((photo, i) => (
        <li>
          <a href={full[i].src} data-lightbox>
            <Image
              src={photo}
              alt={`${category.title}, project ${i + 1}`}
              widths={[400, 800, 1200]}
              sizes="(width >= 64rem) 30vw, (width >= 40rem) 45vw, 90vw"
              loading="lazy"
            />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .gallery + .gallery {
    padding-top: 0;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
  }

  a {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--panel);
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    transition: opacity 200ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    a:hover img {
      opacity: 1;
    }
  }
</style>
