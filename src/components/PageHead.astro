---
interface Props {
  title: string;
  lead: string;
}
const { title, lead } = Astro.props;
---

<section class="section head">
  <div class="container">
    <h1>{title}</h1>
    <p class="lead">{lead}</p>
  </div>
</section>

<style>
  .head {
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--border);
  }

  .lead {
    margin: 0;
  }
</style>
