---
import { nav, site } from "../data";

const path = Astro.url.pathname;
---

<header class="header">
  <div class="container bar">
    <a href="/" class="brand" aria-label={`${site.name}, home`}>
      <span class="mark" aria-hidden="true">CV</span>
      <span class="word">Creative Vision</span>
    </a>
    <button class="burger" popovertarget="menu" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
    <nav id="menu" popover aria-label="Main">
      <button class="close" popovertarget="menu" popovertargetaction="hide" aria-label="Close menu">×</button>
      <ul>
        {nav.map(({ href, label }) => (
          <li><a href={href} aria-current={path === href ? "page" : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.5rem;
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--fg);
  }

  .mark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.9rem;
    color: var(--gold);
    letter-spacing: -0.06em;
  }

  .word {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .burger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 0.6rem;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .burger span {
    width: 24px;
    height: 2px;
    background: var(--fg);
    border-radius: 2px;
  }

  #menu {
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 5rem var(--gutter);
    border: 0;
    background: var(--bg);
    color: var(--fg);
  }

  #menu::backdrop {
    background: transparent;
  }

  .close {
    position: absolute;
    top: 1rem;
    right: var(--gutter);
    font-size: 2rem;
    line-height: 1;
    background: none;
    border: 0;
    color: var(--fg);
    cursor: pointer;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  ul a {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--fg);
    text-decoration: none;
  }

  ul a[aria-current="page"],
  ul a:hover {
    color: var(--gold);
  }

  @media (width >= 48rem) {
    .burger,
    .close {
      display: none;
    }

    #menu {
      display: block;
      position: static;
      width: auto;
      height: auto;
      padding: 0;
      background: none;
    }

    ul {
      flex-direction: row;
      gap: 2rem;
    }

    ul a {
      font-family: var(--font-sans);
      font-size: 0.95rem;
      font-weight: 500;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      position: relative;
      padding-block: 0.3rem;
    }

    ul a::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 2px;
      background: var(--gold);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.3s var(--ease);
    }

    ul a[aria-current="page"]::after,
    ul a:hover::after {
      transform: scaleX(1);
    }
  }
</style>
