---
import { nav, site } from "../data";

const path = Astro.url.pathname;
---

<header class="header">
  <div class="container bar">
    <a href="/" class="brand">{site.name}</a>
    <button class="burger" popovertarget="menu" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
    <nav id="menu" popover aria-label="Main">
      <button class="close" popovertarget="menu" popovertargetaction="hide" aria-label="Close menu">×</button>
      <ul>
        {nav.map(({ href, label }) => (
          <li><a href={href} aria-current={path === href ? "page" : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem;
  }

  .brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    text-transform: uppercase;
    text-decoration: none;
  }

  .burger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 0.6rem;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .burger span {
    width: 24px;
    height: 2px;
    background: var(--fg);
  }

  #menu {
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 5rem var(--gutter);
    border: 0;
    background: var(--bg);
    color: var(--fg);
  }

  #menu::backdrop {
    background: transparent;
  }

  .close {
    position: absolute;
    top: 1rem;
    right: var(--gutter);
    font-size: 2rem;
    line-height: 1;
    background: none;
    border: 0;
    color: var(--fg);
    cursor: pointer;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  ul a {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 3rem;
    text-transform: uppercase;
    text-decoration: none;
  }

  ul a[aria-current="page"] {
    color: var(--muted);
  }

  @media (width >= 48rem) {
    .burger,
    .close {
      display: none;
    }

    #menu {
      display: block;
      position: static;
      width: auto;
      height: auto;
      padding: 0;
      background: none;
    }

    ul {
      flex-direction: row;
      gap: 1.75rem;
    }

    ul a {
      font-family: var(--font-sans);
      font-size: 0.9rem;
      font-weight: 500;
      letter-spacing: 0.04em;
    }

    ul a[aria-current="page"] {
      color: var(--fg);
      text-decoration: underline;
      text-underline-offset: 0.4em;
    }
  }
</style>
