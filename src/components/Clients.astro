---
import { Image } from "astro:assets";
import { clients } from "../data";
---

<section class="section clients" aria-labelledby="clients-title">
  <div class="container">
    <span class="eyebrow">Clients</span>
    <h2 id="clients-title">Our trusted partners</h2>
  </div>
  <div class="track" role="list">
    {[0, 1].map((copy) => (
      <ul aria-hidden={copy === 1 ? "true" : undefined}>
        {clients.map(({ name, img }) => (
          <li role={copy === 0 ? "listitem" : undefined}>
            <Image src={img} alt={copy === 0 ? name : ""} height={40} loading="lazy" />
          </li>
        ))}
      </ul>
    ))}
  </div>
</section>

<style>
  .clients {
    overflow: hidden;
    border-block: 1px solid var(--border);
    background: var(--bg-elevated);
  }

  .track {
    display: flex;
    gap: 4rem;
    width: max-content;
    margin-top: 2rem;
    animation: scroll 50s linear infinite;
    mask: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .track:hover {
    animation-play-state: paused;
  }

  ul {
    display: flex;
    gap: 4rem;
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  img {
    height: 40px;
    width: auto;
    filter: grayscale(1);
    opacity: 0.75;
    transition: 0.3s var(--ease);
  }

  @media (prefers-color-scheme: dark) {
    img {
      filter: grayscale(1) invert(1);
    }
  }

  li:hover img {
    filter: none;
    opacity: 1;
  }

  @keyframes scroll {
    to {
      transform: translateX(calc(-50% - 2rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
      width: auto;
      flex-wrap: wrap;
      mask: none;
      padding-inline: var(--gutter);
    }

    .track ul[aria-hidden] {
      display: none;
    }

    ul {
      flex-wrap: wrap;
      gap: 2rem;
    }
  }
</style>
