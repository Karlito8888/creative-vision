---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Gallery from "../components/Gallery.astro";
import Lightbox from "../components/Lightbox.astro";
import { categories } from "../data";
const total = categories.reduce((n, c) => n + c.photos.length, 0);
---

<Base title="Portfolio" description="Exhibition stands, interiors, kiosks, awards, corporate gifts and signage delivered by Creative Vision across the GCC.">
  <PageHead
    title="Work that leaves the show with you"
    lead={`A selection of our work: ${total} photos across ${categories.length} categories, from exhibition stands to awards.`}
  />

  <nav class="container tabs" aria-label="Categories">
    {categories.map((c) => <a href={`#${c.slug}`}>{c.title} <small>{c.photos.length}</small></a>)}
  </nav>

  {categories.map((c) => <Gallery category={c} />)}

  <section class="section cta">
    <div class="container">
      <h2>Ready to start your project?</h2>
      <a class="btn" href="/contact">Get in touch</a>
    </div>
  </section>

  <Lightbox />
</Base>

<style>
  .cta {
    text-align: center;
    border-top: 1px solid var(--border);
  }
</style>
