---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import { site } from "../data";
---

<Base title="Contact" description="Contact Creative Vision in Dubai for exhibition stands, kiosks, interiors, awards and corporate gifts.">
  <PageHead eyebrow="Contact" title="Let's build something" lead="We help grow your business with bespoke ideas. Tell us about your project." />

  <section class="section">
    <div class="container two">
      <form class="card" id="contact" action={`mailto:${site.email}`} method="post" enctype="text/plain">
        <label>Your name <input name="name" required minlength="2" autocomplete="name" /></label>
        <label>Your email <input name="email" type="email" required autocomplete="email" /></label>
        <label>Your message <textarea name="message" required minlength="10" rows="6"></textarea></label>
        <button class="btn" type="submit">Send message</button>
        <p class="hint">Opens your email app with the message prefilled.</p>
      </form>

      <address>
        <h2>Reach us directly</h2>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.phoneHref}>{site.phone}</a>
        <a href={site.whatsapp} target="_blank" rel="noopener">Chat on WhatsApp</a>
        <p>{site.legalName}<br />{site.address}</p>
      </address>
    </div>
  </section>
</Base>

<script>
  // Compose a readable email instead of the browser's raw "name=…&email=…" body.
  const form = document.getElementById("contact") as HTMLFormElement;
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const subject = `Project enquiry from ${d.get("name")}`;
    const body = `Name: ${d.get("name")}\nEmail: ${d.get("email")}\n\n${d.get("message")}`;
    location.href = `${form.action}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .two {
    display: grid;
    gap: 3rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    align-items: start;
  }

  form {
    padding: 2rem;
    display: grid;
    gap: 1.25rem;
  }

  label {
    display: grid;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 500;
  }

  input,
  textarea {
    font: inherit;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--fg);
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--gold);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--gold) 25%, transparent);
  }

  input:user-invalid,
  textarea:user-invalid {
    border-color: #dc2626;
  }

  button {
    justify-self: start;
    cursor: pointer;
    font: inherit;
  }

  .hint {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  address {
    font-style: normal;
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  address a {
    font-size: 1.15rem;
    text-decoration: none;
    color: var(--fg);
  }

  address a:hover {
    color: var(--gold);
  }

  address p {
    color: var(--muted);
    margin-top: 1rem;
  }
</style>
