---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Clients from "../components/Clients.astro";
import hero from "../assets/images/hero/hero.webp";
import { categories, services, site } from "../data";
---

<Base title="Home">
  <section class="hero">
    <Image
      src={hero}
      alt="Exhibition stand"
      widths={[800, 1200, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="container copy">
      <span class="eyebrow">Dubai · Riyadh · GCC</span>
      <h1>Creativity is intelligence, <em>having fun.</em></h1>
      <p class="lead">
        Exhibition stands, kiosks, showroom fit-outs, signage, awards and corporate gifts. Designed, built and
        delivered by one team, from concept to show floor.
      </p>
      <div class="actions">
        <a class="btn" href="/contact">Start a project</a>
        <a class="btn ghost" href="/portfolio">See our work</a>
      </div>
    </div>
  </section>

  <section class="section intro">
    <div class="container two">
      <blockquote>“{site.tagline}”</blockquote>
      <div>
        <p class="lead">
          Creative Vision is one of the premier exhibition companies in Dubai, Riyadh and throughout the GCC. Our
          expertise lies in creating custom booth displays and fabrications for exhibitions, including corporate
          gifts and other marketing paraphernalia.
        </p>
        <p>
          Design, layout planning and interior fit-out for showrooms, exhibition stands, kiosks, offices and
          restaurants. Visual merchandising solutions, window displays and shop fittings, designed and manufactured
          in-house.
        </p>
      </div>
    </div>
  </section>

  <section class="section services">
    <div class="container">
      <span class="eyebrow">What we do</span>
      <h2>Our services</h2>
      <ul class="grid">
        {services.map((s) => (
          <li class="card reveal">
            <Image src={s.image} alt="" widths={[400, 800]} sizes="(width >= 64rem) 30vw, 90vw" loading="lazy" />
            <div class="body">
              <h3>{s.title}</h3>
              <p>{s.summary}</p>
            </div>
          </li>
        ))}
      </ul>
      <a class="btn ghost" href="/services">Discover all services</a>
    </div>
  </section>

  <section class="section work">
    <div class="container">
      <span class="eyebrow">Portfolio</span>
      <h2>Recent projects</h2>
      <ul class="mosaic">
        {categories.map((c, i) => (
          <li class="reveal">
            <a href={`/portfolio#${c.slug}`}>
              <Image src={c.photos[c.cover]} alt="" widths={[400, 800, 1200]} sizes={i ? "(width >= 48rem) 40vw, 90vw" : "100vw"} loading="lazy" />
              <span>{c.title} <small>{c.photos.length} photos</small></span>
            </a>
          </li>
        ))}
      </ul>
      <a class="btn ghost" href="/portfolio">Explore the portfolio</a>
    </div>
  </section>

  <Clients />
</Base>

<style>
  .hero {
    position: relative;
    min-height: min(92vh, 56rem);
    display: grid;
    align-items: end;
    color: #fff;
    isolation: isolate;
  }

  .hero > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.25), rgb(0 0 0 / 0.75) 80%);
  }

  .copy {
    padding-block: clamp(4rem, 10vw, 7rem);
  }

  .copy .eyebrow {
    color: #e9c866;
  }

  .copy h1 em {
    font-style: italic;
    color: #e9c866;
  }

  .copy .lead {
    color: rgb(255 255 255 / 0.85);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .hero .btn.ghost {
    color: #fff;
    border-color: rgb(255 255 255 / 0.6);
  }

  .hero .btn.ghost:hover {
    background: #fff;
    color: #1f1d18;
  }

  .two {
    display: grid;
    gap: 3rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    align-items: start;
  }

  blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.15;
    color: var(--gold);
  }

  .services .card {
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr;
  }

  .services img {
    aspect-ratio: 16 / 10;
    width: 100%;
    object-fit: cover;
  }

  .body {
    padding: 1.5rem;
  }

  .body p {
    color: var(--muted);
    margin: 0;
  }

  .services .btn,
  .work .btn {
    margin-top: 2.5rem;
  }

  .mosaic {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .mosaic li:first-child {
    grid-column: 1 / -1;
  }

  .mosaic a {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    border-radius: var(--radius);
    overflow: hidden;
    color: #fff;
    text-decoration: none;
  }

  .mosaic li:first-child a {
    aspect-ratio: 21 / 9;
  }

  .mosaic img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .mosaic a:hover img {
    transform: scale(1.04);
  }

  .mosaic span {
    position: absolute;
    inset: auto 0 0;
    padding: 1.25rem;
    font-family: var(--font-display);
    font-size: 1.3rem;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.75));
  }

  .mosaic small {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    opacity: 0.8;
  }
</style>
