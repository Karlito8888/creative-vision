---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Clients from "../components/Clients.astro";
import { categories, services, site } from "../data";
---

<Base title="Home">
  <section class="strip" aria-label="Recent work" tabindex="0">
    {categories.map((c, i) => (
      <article class="slide" id={`show-${c.slug}`}>
        <Image
          src={c.photos[c.cover]}
          alt=""
          widths={[800, 1200, 1800]}
          sizes="100vw"
          loading={i ? "lazy" : "eager"}
          fetchpriority={i ? undefined : "high"}
        />
        <div class="container copy">
          <div>
            <h2>{c.title}</h2>
            <p>{c.blurb}</p>
          </div>
          <a href={`/portfolio#${c.slug}`}>{c.photos.length} photos</a>
        </div>
      </article>
    ))}
  </section>
  <nav class="container tabs" aria-label="Jump to a category">
    {categories.map((c) => <a href={`#show-${c.slug}`}>{c.title}</a>)}
  </nav>

  <section class="section container intro">
    <h1>{site.tagline}</h1>
    <div>
      <p class="lead">
        Creative Vision is one of the premier exhibition companies in Dubai, Riyadh and throughout the GCC. Our
        expertise lies in creating custom booth displays and fabrications for exhibitions, including corporate
        gifts and other marketing paraphernalia.
      </p>
      <p class="lead">
        Design, layout planning and interior fit-out for showrooms, exhibition stands, kiosks, offices and
        restaurants. Visual merchandising solutions, window displays and shop fittings, designed and manufactured
        in-house.
      </p>
      <a class="btn" href="/contact">Start a project</a>
    </div>
  </section>

  <div class="container">
    <ul class="cells">
      {services.map((s) => (
        <li>
          <h3>{s.title}</h3>
          <p>{s.summary}</p>
        </li>
      ))}
      <li>
        <h3>And more</h3>
        <p><a href="/services">Interiors, awards, signage and shop fittings.</a></p>
      </li>
    </ul>
  </div>

  <Clients />
</Base>

<style>
  .strip {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    height: calc(100vh - 4rem);
    min-height: 32rem;
  }

  .strip::-webkit-scrollbar {
    display: none;
  }

  .slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    position: relative;
    display: grid;
    align-items: end;
    isolation: isolate;
  }

  .slide img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .slide::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.15) 40%, rgb(0 0 0 / 0.85));
  }

  .copy {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(3.5rem, 6vw, 5rem);
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 1rem;
  }

  .copy h2 {
    font-size: clamp(3.5rem, 11vw, 11rem);
    margin-bottom: 0.1em;
  }

  .copy p {
    margin: 0;
    max-width: 34ch;
    font-size: 1.15rem;
    color: #ddd;
  }

  .copy a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #ccc;
  }

  .tabs {
    border-bottom: 1px solid var(--border);
  }

  .intro h1 {
    font-size: clamp(2.2rem, 5vw, 4.5rem);
  }

  .intro {
    display: grid;
    gap: 3rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    align-items: start;
  }

  .intro .btn {
    margin-top: 1rem;
  }

  @media (width < 48rem) {
    .copy {
      grid-template-columns: 1fr;
    }
  }
</style>
